FRONTEND_URL=https://netan-inventory.vercel.app
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Netan
ZEPTOMAIL_API_KEY=your_zeptomail_send_mail_token
# Optional override (default: https://api.zeptomail.com/v1.1/email)
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional. Only needed for Prisma/direct Postgres. The app uses the keys above.
# DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres
